# Variables de entorno disponibles en tiempo de build.
# Copiar a `.env` (gitignored) y ajustar. `scripts/generate-env.ts` las inyecta
# en src/environments/*.ts antes de cada build, watch y test.

# API base del backend (termina en /api/v1)
API_URL=https://back-dev.synappta.cloud/api/v1

# URL del servidor de websockets
SOCKET_URL=ws://localhost:3000

# Entorno de despliegue (development | production)
ATMOSPHERE=development

# Idioma inicial de la app (es | en)
DEFAULT_LANGUAGE=es

# Tema inicial de la app (dark | light)
DEFAULT_THEME=dark

# Moneda por defecto (ISO 4217)
DEFAULT_CURRENCY=COP

# Zona horaria IANA
DEFAULT_TIMEZONE=America/Bogota

# Formato de fecha (tokens de Angular DatePipe)
DEFAULT_DATE_FORMAT=dd/MM/yyyy

# Formato de hora (tokens de Angular DatePipe)
DEFAULT_TIME_FORMAT=HH:mm:ss

# Formato de fecha y hora (tokens de Angular DatePipe)
DEFAULT_DATE_TIME_FORMAT=dd/MM/yyyy HH:mm:ss

# Decimales para formatos numéricos
DEFAULT_DECIMAL_PLACES=2
